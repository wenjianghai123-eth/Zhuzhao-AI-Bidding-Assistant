{
  "name": "zhuzhao-ai-bidding-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:postgres": "tsx scripts/run-postgres-e2e.ts",
    "test:acceptance": "vitest run src/server/integration/mvp-acceptance.test.ts",
    "audit:percentages": "tsx scripts/audit-percentages.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:schema:postgres": "tsx scripts/generate-postgresql-schema.ts",
    "db:schema:postgres:check": "tsx scripts/generate-postgresql-schema.ts --check",
    "db:generate:postgres": "tsx scripts/generate-postgresql-client.ts",
    "db:prepare": "tsx scripts/ensure-sqlite.ts",
    "db:migrate": "tsx scripts/ensure-sqlite.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/ensure-sqlite.ts && prisma migrate deploy",
    "db:migrate:deploy": "tsx scripts/deploy-postgresql-migrations.ts",
    "db:migrate:deploy:sqlite": "tsx scripts/ensure-sqlite.ts && prisma migrate deploy",
    "db:migrate:sqlite-to-postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:postgres:start": "docker compose -f docker-compose.postgres.yml up -d",
    "db:postgres:stop": "docker compose -f docker-compose.postgres.yml down",
    "db:seed": "prisma db seed",
    "seed:demo": "prisma db seed",
    "db:verify": "tsx scripts/verify-database.ts",
    "verify:settings": "tsx scripts/verify-project-settings-flow.ts",
    "verify:candidates": "tsx scripts/verify-candidate-flow.ts",
    "verify:performance": "tsx scripts/verify-performance-flow.ts",
    "verify:qingbiao": "tsx scripts/verify-qingbiao-flow.ts",
    "verify:dingbiao": "tsx scripts/verify-dingbiao-flow.ts",
    "verify:global-analysis": "tsx scripts/verify-global-analysis-flow.ts",
    "verify:business-golden": "vitest run src/domain/regression/20260820-full-golden.test.ts --reporter=verbose",
    "verify:decimal-persistence": "vitest run src/server/db/decimal-persistence.test.ts src/domain/regression/decimal-persistence.test.ts src/domain/regression/20260820-full-golden.test.ts --reporter=verbose",
    "verify:presentation": "vitest run src/lib/presentation.test.ts src/lib/formatters.test.ts src/lib/percentage.test.ts --reporter=verbose",
    "verify:excel-export": "vitest run src/server/exports/analysis-excel-exporter.test.ts src/server/application/analysis-delivery-service.test.ts src/domain/regression/20260820-full-golden.test.ts --reporter=verbose",
    "verify:excel-import": "tsx scripts/verify-excel-import-flow.ts",
    "verify:secrets": "tsx scripts/verify-secrets.ts",
    "verify:postgres": "tsx scripts/verify-postgres.ts",
    "verify:repository-postgres": "tsx scripts/verify-repository-postgres.ts",
    "verify:cross-db-golden": "tsx scripts/verify-cross-db-golden.ts",
    "verify:staging": "tsx scripts/verify-staging.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
