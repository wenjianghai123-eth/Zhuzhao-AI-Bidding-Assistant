generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  DRAFT
  CALCULATED
  COMPLETED
}

enum ProjectType {
  CURTAIN_WALL
  DECORATION
  GENERAL_CONTRACT
  LABORATORY
}

model Project {
  id                     String                  @id @default(cuid())
  name                   String
  status                 ProjectStatus           @default(DRAFT)
  qingbiaoInputRevision  Int                     @default(1)
  dingbiaoInputRevision  Int                     @default(1)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  rule                   ProjectRule?
  candidates             ProjectCandidate[]
  qingbiaoExclusionRules QingbiaoExclusionRule[]
  qingbiaoScenarios      QingbiaoScenario[]
  dingbiaoScenarios      DingbiaoScenario[]

  @@index([status])
  @@index([createdAt])
}

model ProjectRule {
  projectId          String                   @id
  maxBidPrice        Decimal
  nonCompetitiveFee  Decimal
  totalBidPriceScore Decimal
  rankDeduction      Decimal
  finalDrawValue1    Decimal
  finalDrawValue2    Decimal
  finalDrawValue3    Decimal
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTypes       ProjectRuleProjectType[]
}

model ProjectRuleProjectType {
  projectId   String
  projectType ProjectType
  projectRule ProjectRule @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@id([projectId, projectType])
  @@index([projectType])
}

model ProjectCandidate {
  id                     String                           @id @default(cuid())
  projectId              String
  companyName            String
  bidPrice               Decimal
  netDiscountRate        Decimal
  trademarkScore         Decimal
  technicalScore         Decimal
  similarExperienceScore Decimal
  otherScore             Decimal
  isOurCompany           Boolean                          @default(false)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  project                Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qingbiaoSelections     QingbiaoScenarioCandidate[]
  qingbiaoExclusions     QingbiaoExclusionRuleCandidate[]
  qingbiaoResults        QingbiaoResult[]
  dingbiaoResults        DingbiaoResult[]

  @@unique([projectId, companyName])
  @@index([projectId])
  @@index([companyName])
  @@index([projectId, isOurCompany])
}

model CompanyPerformance {
  id                  String      @id @default(cuid())
  companyName         String
  projectType         ProjectType
  classificationLevel String
  year                Int
  quarter             Int
  score               Decimal
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([companyName, projectType, year, quarter])
  @@index([companyName, projectType])
  @@index([projectType, year, quarter])
  @@index([year, quarter])
}

model QingbiaoExclusionRule {
  id                 String                           @id @default(cuid())
  projectId          String
  ruleIndex          Int
  label              String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  project            Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  excludedCandidates QingbiaoExclusionRuleCandidate[]
  scenarios          QingbiaoScenario[]

  @@unique([projectId, ruleIndex])
  @@index([projectId])
}

model QingbiaoExclusionRuleCandidate {
  exclusionRuleId String
  candidateId     String
  createdAt       DateTime              @default(now())
  exclusionRule   QingbiaoExclusionRule @relation(fields: [exclusionRuleId], references: [id], onDelete: Cascade)
  candidate       ProjectCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([exclusionRuleId, candidateId])
  @@index([candidateId])
}

model QingbiaoScenario {
  id                       String                      @id @default(cuid())
  projectId                String
  exclusionRuleId          String?
  qingbiaoK2               Int                         @map("k2Value")
  referencePriceB          Decimal
  qingbiaoK1               Decimal
  referencePriceBCanonical String?
  qingbiaoK1Canonical      String?
  isLegacy                 Boolean                     @default(false)
  version                  Int                         @default(1)
  inputRevision            Int
  ruleVersion              String
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  project                  Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exclusionRule            QingbiaoExclusionRule?      @relation(fields: [exclusionRuleId], references: [id], onDelete: Restrict)
  selectedCandidates       QingbiaoScenarioCandidate[]
  results                  QingbiaoResult[]
  legacyDingbiaoScenarios  DingbiaoScenario[]          @relation("LegacyDingbiaoSource")
  sourceDingbiaoScenarios  DingbiaoScenario[]          @relation("DingbiaoSource")

  @@unique([exclusionRuleId, qingbiaoK2], map: "QingbiaoScenario_exclusionRuleId_k2Value_key")
  @@index([projectId, createdAt])
  @@index([exclusionRuleId])
}

model QingbiaoScenarioCandidate {
  scenarioId  String
  candidateId String
  createdAt   DateTime         @default(now())
  scenario    QingbiaoScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  candidate   ProjectCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([scenarioId, candidateId])
  @@index([candidateId])
}

model QingbiaoResult {
  id                          String           @id @default(cuid())
  scenarioId                  String
  candidateId                 String
  performanceAverage          Decimal
  performanceScore            Decimal
  priceDifference             Decimal
  performanceAverageCanonical String?
  performanceScoreCanonical   String?
  priceDifferenceCanonical    String?
  priceRank                   Int
  priceScore                  Decimal
  totalScore                  Decimal
  priceScoreCanonical         String?
  totalScoreCanonical         String?
  finalRank                   Int
  createdAt                   DateTime         @default(now())
  scenario                    QingbiaoScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  candidate                   ProjectCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, candidateId])
  @@index([candidateId])
  @@index([scenarioId, finalRank])
  @@index([scenarioId, priceRank])
}

model DingbiaoScenario {
  id                       String            @id @default(cuid())
  projectId                String
  qingbiaoScenarioId       String
  sourceQingbiaoScenarioId String?
  qingbiaoK2               Int               @map("qingbiaoK2Value")
  finalistCount            Int
  finalDrawSlot            Int
  finalDrawIndex           Int?
  finalDrawValue           Decimal
  dingbiaoK1               Decimal
  benchmarkPriceM          Decimal
  finalDrawValueCanonical  String?
  dingbiaoK1Canonical      String?
  benchmarkPriceMCanonical String?
  version                  Int               @default(1)
  inputRevision            Int
  ruleVersion              String
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  project                  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qingbiaoScenario         QingbiaoScenario  @relation("LegacyDingbiaoSource", fields: [qingbiaoScenarioId], references: [id], onDelete: Restrict)
  sourceQingbiaoScenario   QingbiaoScenario? @relation("DingbiaoSource", fields: [sourceQingbiaoScenarioId], references: [id], onDelete: Restrict)
  results                  DingbiaoResult[]

  @@unique([sourceQingbiaoScenarioId, finalistCount, finalDrawIndex], map: "DingbiaoScenario_sourceScenario_finalistCount_drawIndex_key")
  @@index([projectId, createdAt])
  @@index([qingbiaoScenarioId])
  @@index([sourceQingbiaoScenarioId])
}

model DingbiaoResult {
  id                               String           @id @default(cuid())
  scenarioId                       String
  candidateId                      String
  sourceQingbiaoRank               Int?
  bidPrice                         Decimal
  netDiscountRateSnapshot          Decimal?
  differenceToM                    Decimal
  bidPriceCanonical                String?
  netDiscountRateSnapshotCanonical String?
  differenceToMCanonical           String?
  rank                             Int
  isWinner                         Boolean          @default(false)
  createdAt                        DateTime         @default(now())
  scenario                         DingbiaoScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  candidate                        ProjectCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, candidateId])
  @@index([candidateId])
  @@index([scenarioId, rank])
  @@index([scenarioId, isWinner])
}
